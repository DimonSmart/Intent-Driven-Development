  "cards": [
    {
      "dot": "emerald",
      "title": "Durable boundary",
      "items": [
        "Product Intent is current durable product truth",
        "Engineering Rules and verification policy are optional, separate operational layers",
        "Clarification or research may stop before implementation"
      ]
    },
    {
      "dot": "violet",
      "title": "Factory is optional orchestration",
      "items": [
        "Durable preparation and coverage complete before active orchestration",
        "Fresh planners and workers use repository reality, not inherited transcripts",
        "Tasks, plans, and state are temporary; Git preserves revision history"
      ]
    },
    {
      "dot": "rose",
      "title": "No hidden lifecycle machine",
      "items": [
        "Question stops for an answer",
        "Verification failure is bounded input to a fresh planner",
        "Factory does not own retries, process supervision, or a verification engine"
      ]
    }
  ]
