  "cards": [
    {
      "dot": "emerald",
      "title": "Current truth wins",
      "items": [
        "Product changes update the current owning Intent document before implementation when both are requested.",
        "Intent is not a task history; Git keeps revisions."
      ]
    },
    {
      "dot": "violet",
      "title": "Two execution modes",
      "items": [
        "A direct Coding Agent is sufficient for focused changes.",
        "Factory is optional orchestration for complex multi-task work."
      ]
    },
    {
      "dot": "cyan",
      "title": "Independent checks",
      "items": [
        "Lint, structure audit, drift audit, and technical verification serve different purposes.",
        "Read-only audit never silently edits code or Intent."
      ]
    }
