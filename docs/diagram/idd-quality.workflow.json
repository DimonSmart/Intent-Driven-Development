  "cards": [
    {
      "dot": "cyan",
      "title": "Not interchangeable",
      "items": [
        "Lint validates mechanical document consistency; structure audit checks semantic organization.",
        "Drift audit is read-only and measures implementation against Intent, not general code quality."
      ]
    },
    {
      "dot": "amber",
      "title": "Writing requires authority",
      "items": [
        "Only explicitly requested safe lint fixes can edit mechanically.",
        "Normalization is a separate propose/apply workflow; audit findings never silently trigger writes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Project verification is operational",
      "items": [
        "Commands live in .idd/verification.yaml when configured, not in Product Intent.",
        "Direct Agent or Factory consumes verification evidence; Factory does not own another verification engine."
      ]
    }
