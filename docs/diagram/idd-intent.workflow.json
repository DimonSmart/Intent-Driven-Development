  "cards": [
    {
      "dot": "emerald",
      "title": "Bootstrap versus import",
      "items": [
        "Bootstrap reconstructs a proposal from an undocumented product and requires approval.",
        "Import migrates established external knowledge without treating code as the source of product truth."
      ]
    },
    {
      "dot": "cyan",
      "title": "Visual intent is product intent",
      "items": [
        "Visual discovery is read-only; confirmed Essential / Preferred / Free / Avoid requirements go through the ordinary Intent owner.",
        "Clear requirements skip redundant brainstorming."
      ]
    },
    {
      "dot": "violet",
      "title": "Knowledge stays current",
      "items": [
        "Edit the smallest existing owner, create only when needed, remove obsolete specs rather than archiving them.",
        "Mechanical lint, normalization and drift audit are shown in Quality & Conformance."
      ]
    }
