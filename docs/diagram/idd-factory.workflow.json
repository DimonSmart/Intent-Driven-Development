  "cards": [
    {
      "dot": "emerald",
      "title": "Preflight owns the gate",
      "items": [
        "Persist the original Git baseline and provenance before authorized durable writes.",
        "Engineering owner changes precede Product Intent owner changes; validate coverage before activation."
      ]
    },
    {
      "dot": "violet",
      "title": "Fresh contexts, not a workflow engine",
      "items": [
        "Planner is read-only and issues bounded Tasks, one Question, or Done.",
        "Each Worker uses fresh context; only Workers may add proven monotonic refinements to existing Intent owners."
      ]
    },
    {
      "dot": "rose",
      "title": "Stops are real boundaries",
      "items": [
        "Known missing decisions block before mutations; Question pauses until an exact answer.",
        "Verification failure returns bounded evidence to a new Planner, not an automatic root-level repair.",
        "After success, review Intent refinements independently of the implementation result."
      ]
    }
  ]
