<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>DimonSmart.IntentDrivenDevelopment</PackageId>
    <Version>1.0.0</Version>
    <Authors>DimonSmart</Authors>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>.NET-friendly distribution of Intent-Driven Development canonical methodology, adapters, and generated AI coding agent files.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\src\canonical\**\*" Pack="true" PackagePath="src/canonical/" />
    <Content Include="..\src\adapters\**\*" Pack="true" PackagePath="src/adapters/" />
    <Content Include="..\generated\**\*" Pack="true" PackagePath="generated/" />
    <Content Include="..\tools\generate\**\*" Pack="true" PackagePath="tools/generate/" />
    <Content Include="..\tools\smoke-tests\**\*" Pack="true" PackagePath="tools/smoke-tests/" />
    <None Include="..\manifest.json" Pack="true" PackagePath="/" Visible="false" Condition="Exists('..\manifest.json')" />
    <None Include="..\README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="..\LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
