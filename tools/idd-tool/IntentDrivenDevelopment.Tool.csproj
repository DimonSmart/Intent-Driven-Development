<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>intent-driven-development</ToolCommandName>
    <PackageId>DimonSmart.IntentDrivenDevelopment.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>DimonSmart</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Description>.NET global tool installer for Intent-Driven Development generated CodingAgent files.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="icon.png" Pack="true" PackagePath="/" Visible="false" />
    <Content Include="..\..\manifest.json" Pack="true" PackagePath="tools/$(TargetFramework)/any/package-content/manifest.json" Condition="Exists('..\..\manifest.json')" />
    <Content Include="..\..\README.md" Pack="true" PackagePath="tools/$(TargetFramework)/any/package-content/" />
    <Content Include="..\..\LICENSE" Pack="true" PackagePath="tools/$(TargetFramework)/any/package-content/" />
    <Content Include="..\..\src\**\*" Pack="true" PackagePath="tools/$(TargetFramework)/any/package-content/src/" />
    <Content Include="..\..\generated\**\*" Pack="true" PackagePath="tools/$(TargetFramework)/any/package-content/generated/" />
  </ItemGroup>
</Project>
